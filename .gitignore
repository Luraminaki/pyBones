# Raw micro-CT dataset (617 MB, in data/) and anything derived from it; data/ itself is kept
data_set.zip
/data/*
!/data/.gitkeep
output/

# Log files (one per process: <stem>-<pid>.log, rotated)
logs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
# ...but not three.js's own build/ folder, vendored for the web page.
!src/pybones/server/static/vendor/three/build/

# Editors / OS
.idea/
*.m~
.DS_Store

# Annotation workspaces: crops and pre-fills are regenerated from the dataset
# (python -m tools.annotation regenerate); manifest.json and labels/ are versioned.
annotations/*/crops/
annotations/*/prefill/

# Coverage data (pytest --cov)
.coverage
