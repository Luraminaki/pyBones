{
  "workspace_root": "annotations",
  "files": {
    "manifest": "manifest.json",
    "labels_dir": "labels",
    "crops_dir": "crops",
    "prefill_dir": "prefill",
    "label_png_template": "{crop_id}.png",
    "crop_png_template": "{crop_id}_{offset:+d}.png",
    "notes_dir": "notes",
    "note_template": "{crop_id}.txt"
  },
  "crops": {
    "size": 256,
    "context_slices": 3,
    "z_samples": 6,
    "min_tissue_fraction": 0.2,
    "n_burst": 2,
    "n_vessel": 4,
    "n_random": 4,
    "seed": 2018
  },
  "prefill": true,
  "unsure_value": 255,
  "max_note_chars": 2000,
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "display": {
    "scale": 3,
    "overlay_alpha": 0.45,
    "unsure_rgb": [230, 0, 230],
    "undo_depth": 50,
    "max_brush_radius": 20,
    "max_zoom": 12,
    "zoom_step": 1.25,
    "autosave_seconds": 5,
    "wand_tolerance": 20,
    "max_wand_tolerance": 80
  }
}
